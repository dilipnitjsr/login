# Copy this file to .env for local development.
# Never put real secrets in this example file.

DJANGO_SECRET_KEY=replace-with-a-new-random-secret

KITE_API_KEY=replace-with-kite-api-key
KITE_API_SECRET=replace-with-kite-api-secret

DB_NAME=replace-with-database-name
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_HOST=replace-with-database-host
DB_PORT=5432

# Optional login notification
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
